docs
specs
*.md
!README.md

# Env and secrets (must be provided at runtime)
.env
.env.*
!.env.example

# Build and tooling (pyproject.toml and uv.lock are needed for Docker build)
.uv
ruff.toml
alembic.ini
alembic
